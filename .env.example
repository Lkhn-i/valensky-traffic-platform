API_PORT=8787
APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=240
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_BASE_URL=http://127.0.0.1:4173
APP_STORAGE_DRIVER=sqlite
APP_SQLITE_PATH=server/data/app.sqlite
APP_SQLITE_BIN=sqlite3

# Robokassa checkout. Keep real passwords only in server env, never in git.
ROBOKASSA_MERCHANT_LOGIN=Gutz_payments
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST_MODE=true
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_RECEIPT_ENABLED=false
ROBOKASSA_TAX=none

# Access delivery after successful Robokassa payment.
# Use SMTP for reliable email. If SMTP is not configured, ACCESS_DELIVERY_MODE=auto
# stores the access message in server/data/access-outbox.json.
ACCESS_DELIVERY_MODE=auto
ACCESS_EMAIL_FROM="Менторство Валенского <no-reply@valenskytraffic.ru>"
ACCESS_EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SENDMAIL_PATH=/usr/sbin/sendmail
ACCESS_EMAIL_RETRY_INTERVAL_MS=600000

# Kinescope playback protection.
# Put the same secret into the Kinescope auth backend settings if you use drmauthtoken validation.
KINESCOPE_DRM_JWT_SECRET=replace-with-long-random-secret
KINESCOPE_DRM_ISSUER=chalk-learning-platform
KINESCOPE_DRM_AUDIENCE=kinescope-drm
KINESCOPE_DRM_TOKEN_TTL_SECONDS=900

# Required in production for calls from Kinescope to /api/kinescope/drm-auth.
KINESCOPE_DRM_AUTH_USER=replace-with-kinescope-auth-user
KINESCOPE_DRM_AUTH_PASSWORD=replace-with-kinescope-auth-password

# Override only if Kinescope changes the embed host.
KINESCOPE_EMBED_BASE_URL=https://kinescope.io/embed
