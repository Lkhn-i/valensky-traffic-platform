# Copy to `.env` for local overrides without Docker.
DJANGO_SETTINGS_MODULE=config.settings.local
APP_ENV=local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECRET_KEY=dev-insecure-stage1-change-me

# Local default: SQLite and in-memory cache.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=learning_site
POSTGRES_USER=learning_site
POSTGRES_PASSWORD=learning_site
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
DJANGO_LOG_LEVEL=INFO
